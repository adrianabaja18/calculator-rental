# =====================================================================
# apps/raspberry-pi/.env.example
# Copy to apps/raspberry-pi/.env and fill in real values.
# .env is git-ignored. NEVER commit real secrets.
# =====================================================================

# Base URL of the Next.js web app (NOT the Supabase URL).
#   Laptop development:   http://localhost:3000
#   Pi -> laptop on LAN:  http://<laptop-LAN-IP>:3000
#   Production:           https://<your-deployed-app>
BACKEND_URL=http://localhost:3000

# Unique ID of this kiosk. Must match a row in device_registry (Phase 2).
DEVICE_ID=DEVICE-CALC-KIOSK-001

# Per-device secret. The backend stores only its SHA-256 hash.
# Phase 9 generates the real value; this placeholder only satisfies validation.
DEVICE_SECRET=dev-only-placeholder-secret-change-me

# Local SQLite file (offline cache/queue). Created automatically.
#   Laptop: ./data/kiosk.db
#   Pi:     /var/lib/calc-kiosk/kiosk.db  (set up in Phase 9)
SQLITE_PATH=./data/kiosk.db

# mock = simulated hardware + keyboard console (laptop / no wiring yet)
# real = Raspberry Pi pins via hw-bridge/hw_bridge.py (Phase 11, docs/raspberry-pi.md)
HARDWARE_MODE=mock

# ---- Real hardware wiring (BCM pin numbers; defaults match docs/raspberry-pi.md) ----
# PYTHON_BIN=python3
# Solenoid relays, one per locker channel (1,2,...). ACE 6345 board is active-LOW.
RELAY_PINS=5,6
RELAY_ACTIVE_LOW=true
# Test pulse for "unlock <n>" in hwcheck:pi (ms). The kiosk itself keeps a locker
# unlocked until its red button is pressed, at most the removal/return timeout.
LOCK_PULSE_MS=3000
# Coin selector COIN line through the PC817 optocoupler.
COIN_PIN=17
# Quiet time that ends one coin's pulse train. Raise to 300 if coins are split.
COIN_PULSE_GAP_MS=200
BUZZER_PIN=18
# true if your buzzer module is "low level trigger"
BUZZER_ACTIVE_LOW=false
# RC522 readers: SPI bus.device per locker channel (CE0 = 0.0, CE1 = 0.1)
RFID_SPI=0.0,0.1
# RC522 RST pins per reader (pin 7 = GPIO 4, pin 36 = GPIO 16). The bridge holds them HIGH.
# Empty = RST wired straight to 3.3 V.
RFID_RST_PINS=4,16
I2C_BUS=1
# 16x2 LCD backpack address: 0x27 or 0x3F (find with: i2cdetect -y 1)
LCD_I2C_ADDRESS=0x27
# Front-panel buttons per locker (1,2): microswitch COM -> GND, NO -> pin.
# Blue = choose this locker. Red = "I closed the door" (locks the solenoid).
SELECT_BUTTON_PINS=24,25
CLOSE_BUTTON_PINS=22,23
# Optional door sensors (reed switches) per locker. Empty = none fitted.
DOOR_PINS=

# Power saving: after this long idle on the ready screen the kiosk sleeps
# (LCD backlight, ESP32-CAM camera and RFID readers off); any button wakes it.
# Outside operating hours it sleeps after CLOSED_SLEEP_AFTER_SECONDS.
POWER_SAVE=true
SLEEP_AFTER_SECONDS=120
CLOSED_SLEEP_AFTER_SECONDS=30

# QR scanner: mock = type student names in the console;
# serial = the ESP32-CAM on SCANNER_PORT (see firmware/esp32-cam/README.md)
QR_SCANNER=mock
#   Raspberry Pi: /dev/ttyUSB0    Windows: COM7 (run: npm run scanner:pi)
SCANNER_PORT=/dev/ttyUSB0

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# true = human-readable coloured logs (development); false = JSON lines (production)
LOG_PRETTY=true

# Timeout for each backend HTTP request, in milliseconds.
HTTP_TIMEOUT_MS=8000
