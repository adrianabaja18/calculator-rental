# =====================================================================
# apps/raspberry-pi/.env.example
# Copy to apps/raspberry-pi/.env and adjust as needed.
# .env is git-ignored. NEVER commit real secrets.
# =====================================================================

# Local web app URL on this Raspberry Pi (used by `npm run check:pi`).
BACKEND_URL=http://localhost:3000

# ---- Optional Cloud Sync (for online read-only monitoring) ----------
# Set CLOUD_SYNC_ENABLED=false for 100% offline-only operation, or keep true to push
# local SQLite changes and heartbeats to the online monitor whenever internet is available.
CLOUD_SYNC_ENABLED=true
CLOUD_BACKEND_URL=https://calculator-rental.vercel.app
# Keep SYNC_PULL_ENABLED=false so the Raspberry Pi's local SQLite remains the single authority.
SYNC_PULL_ENABLED=false

# When false, the Pi starts offline without waiting for internet NTP (an officer can also
# sync the kiosk clock anytime from their phone/laptop on /devices).
REQUIRE_NTP_SYNC=false

# Unique ID of this kiosk. Matches device_registry in cloud when syncing.
DEVICE_ID=DEVICE-CALC-KIOSK-001
DEVICE_SECRET=dev-only-placeholder-secret-change-me

# Shared local SQLite file (read/written by both the kiosk and local web dashboard).
#   Laptop / default: ./data/kiosk.db
#   Raspberry Pi:     ./data/kiosk.db  (or /var/lib/calc-kiosk/kiosk.db)
SQLITE_PATH=./data/kiosk.db

# mock = simulated hardware + keyboard console (laptop / testing)
# real = Raspberry Pi pins via hw-bridge/hw_bridge.py (docs/raspberry-pi.md)
HARDWARE_MODE=mock

# ---- Real hardware wiring (BCM pin numbers; defaults match docs/raspberry-pi.md) ----
RELAY_PINS=5,6
RELAY_ACTIVE_LOW=true
LOCK_PULSE_MS=3000
COIN_PIN=17
COIN_PULSE_GAP_MS=200
BUZZER_PIN=18
BUZZER_ACTIVE_LOW=false
RFID_SPI=0.0,0.1
RFID_RST_PINS=4,16
I2C_BUS=1
LCD_I2C_ADDRESS=0x27
SELECT_BUTTON_PINS=24,25
CLOSE_BUTTON_PINS=22,23
DOOR_PINS=

# Power saving
POWER_SAVE=true
SLEEP_AFTER_SECONDS=120
CLOSED_SLEEP_AFTER_SECONDS=30

# Student ID scanning:
#   phone  = press any kiosk button -> the LCD shows a 6-digit code -> the student
#            sends their ID from their phone at http://<pi-ip>:3000/scan (the web
#            app must be running on the Pi; no internet needed, just the LAN/hotspot)
#   mock   = type student names in the console
#   serial = the old ESP32-CAM on SCANNER_PORT (retired)
QR_SCANNER=phone
SCANNER_PORT=/dev/ttyUSB0

LOG_LEVEL=info
LOG_PRETTY=true
HTTP_TIMEOUT_MS=8000
