# =====================================================================
# apps/web/.env.example
# Copy to apps/web/.env.local and fill in real values.
# .env.local is git-ignored. NEVER commit real keys.
# =====================================================================

# --- Supabase (Dashboard -> Project Settings -> API / API Keys) -------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public key that is SAFE to ship to the browser (protected by Row Level Security).
# Use the legacy "anon" key (eyJ...) or the new "publishable" key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY key that BYPASSES Row Level Security.
# Use the legacy "service_role" key (eyJ...) or the new "secret" key (sb_secret_...).
# It has NO "NEXT_PUBLIC_" prefix, so Next.js never sends it to the browser.
# Never give this key to the Raspberry Pi or the ESP32-CAM.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ------------------------------------------------------
# Public base URL of this web app. The Raspberry Pi's BACKEND_URL points here.
APP_URL=http://localhost:3000

# NOTE: Devices do NOT share one global DEVICE_API_SECRET.
# Each Raspberry Pi gets its own secret; only its SHA-256 hash is stored in
# the device_registry table (Phase 2 / Phase 9). See docs/architecture.md.
