# =====================================================================
# apps/web/.env.example
# Copy to apps/web/.env.local.
# .env.local is git-ignored. NEVER commit real secrets.
# =====================================================================

# --- Deployment Mode -------------------------------------------------
# `local`    = Raspberry Pi 4 / local mode (DEFAULT): reads & writes the
#              local SQLite database (`SQLITE_PATH`), local admin login,
#              full officer controls, works 100% offline.
# `supabase` = Online monitoring dashboard (e.g. Vercel): read-only view
#              backed by Supabase, receiving outbound sync pushes from the Pi.
NEXT_PUBLIC_DATA_BACKEND=local

# --- Local Mode Settings (`NEXT_PUBLIC_DATA_BACKEND=local`) ----------
# Path to the shared SQLite file. Defaults to ../raspberry-pi/data/kiosk.db.
# SQLITE_PATH=../raspberry-pi/data/kiosk.db

# Optional overrides for the initial Super Admin created on first boot:
# LOCAL_ADMIN_EMAIL=admin@calcrental.ph
# LOCAL_ADMIN_PASSWORD=CalcAdmin2026!
# LOCAL_ADMIN_NAME=Local Super Admin

# Student phone scan page link printed on the kiosk sticker (Devices page).
# Default: the address you opened the dashboard with. Set it if that differs
# from what phones use, e.g. SCAN_PAGE_URL=http://192.168.1.50:3000/scan
# SCAN_PAGE_URL=

# Device credentials accepted by local /api/device/heartbeat checks:
DEVICE_ID=DEVICE-CALC-KIOSK-001
DEVICE_SECRET=dev-only-placeholder-secret-change-me

# --- Online Cloud Monitor Settings (`NEXT_PUBLIC_DATA_BACKEND=supabase`) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this web app.
APP_URL=http://localhost:3000
